# ─────────────────────────────────────────────────────
# .gitignore — Damolak Microservices
# ─────────────────────────────────────────────────────

# ── Node.js ──────────────────────────────────────────
node_modules/
npm-debug.log*
coverage/
.env
.env.*

# ── Java ─────────────────────────────────────────────
target/
*.class
*.jar
*.war
.idea/
*.iml

# ── Python ───────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
dist/
venv/
.venv/

# ── Go ───────────────────────────────────────────────
/processing-service/processing-service

# ── Terraform ────────────────────────────────────────
.terraform/
*.tfstate
*.tfstate.backup
*.tfplan
.terraform.lock.hcl
crash.log

# ── Docker ───────────────────────────────────────────
docker-compose.override.yml

# ── IDE ──────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
